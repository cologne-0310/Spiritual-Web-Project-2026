{
  "rewrites": [
    {
      "source": "/test-rewrite",
      "destination": "/sajeev-site/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sajeev.source31.com"
        }
      ],
      "destination": "/sajeev-site/:path*"
    }
  ]
}