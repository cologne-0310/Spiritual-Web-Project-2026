{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "sajeev.source31.com"
        }
      ],
      "destination": "/diagnostic-404.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sajeev.source31.com"
        }
      ],
      "destination": "/sajeev-site/$1"
    }
  ]
}