{
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/(assets/.*|style\\.css|supabase-config\\.js)$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sajeev.source31.com"
        }
      ],
      "dest": "/sajeev-site/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}