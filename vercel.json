{
  "rewrites": [
    {
      "source": "/test-sajeev-host",
      "has": [
        {
          "type": "host",
          "value": "sajeev.source31.com"
        }
      ],
      "destination": "/sajeev-site/index.html"
    },
    {
      "source": "/test-main-host",
      "has": [
        {
          "type": "host",
          "value": "www.source31.com"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sajeev.source31.com"
        }
      ],
      "destination": "/sajeev-site/$1"
    }
  ]
}